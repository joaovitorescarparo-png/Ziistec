# Na Vercel: Project Settings → Environment Variables.
# Adicione as duas abaixo e faça o Deploy. Não existe .env em produção.
# Use a chave publishable/anon: ela é pública por design e quem protege
# os dados é a RLS. A service_role NUNCA entra aqui nem no frontend.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publishable

# IA externa (somente servidor, nunca com prefixo VITE_). Desligada por padrão: sem as três
# primeiras, nenhuma chamada sai do servidor. A chave real só existe no painel da Vercel.
# ENABLE_EXTERNAL_AI=true
# AI_PROVIDER=gemini
# GEMINI_API_KEY=configure-somente-na-vercel
# GEMINI_MODEL=gemini-3.5-flash-lite
